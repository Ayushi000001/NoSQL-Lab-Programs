# Lab 3: Event logging
# Row key format: event_id. Timestamp is stored as a value for simple demonstration.
create 'EventLog', 'event', 'user', 'details'
put 'EventLog', 'EVT1001', 'event:timestamp', '2026-10-10T10:00:00'
put 'EventLog', 'EVT1001', 'event:type', 'LOGIN'
put 'EventLog', 'EVT1001', 'event:status', 'SUCCESS'
put 'EventLog', 'EVT1001', 'user:user_id', 'U101'
put 'EventLog', 'EVT1001', 'user:username', 'Aarav'
put 'EventLog', 'EVT1002', 'event:timestamp', '2026-10-10T10:05:00'
put 'EventLog', 'EVT1002', 'event:type', 'PURCHASE'
put 'EventLog', 'EVT1002', 'event:status', 'SUCCESS'
put 'EventLog', 'EVT1002', 'user:user_id', 'U102'
put 'EventLog', 'EVT1002', 'user:username', 'Diya'
put 'EventLog', 'EVT1003', 'event:timestamp', '2026-10-10T10:10:00'
put 'EventLog', 'EVT1003', 'event:type', 'LOGOUT'
put 'EventLog', 'EVT1003', 'event:status', 'SUCCESS'
put 'EventLog', 'EVT1003', 'user:user_id', 'U101'
put 'EventLog', 'EVT1003', 'user:username', 'Aarav'
get 'EventLog', 'EVT1002'
get 'EventLog', 'EVT1003'
scan 'EventLog'
